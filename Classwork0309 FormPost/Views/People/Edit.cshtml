@using Classwork0309_FormPost.Models
@model EditPersonViewModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>EditPersonForm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">
        <div class="row">
            <form method="post" action="/people/update">
                <div class="col-md-6 offset-md-3 mt-3">
                    <h1>Edit Person</h1>
                </div>
                <div class="col-md-6 offset-md-3 mt-3">
                    <input type="text" value="@Model.FirstName" class="form-control" name="firstname" placeholder="Enter first name" />
                </div>
                <div class="col-md-6 offset-md-3 mt-3">
                    <input type="text" value="@Model.LastName" class="form-control" name="lastname" placeholder="Enter last name" />
                </div>
                <div class="col-md-6 offset-md-3 mt-3">
                    <input type="text" value="@Model.Age" class="form-control" name="age" placeholder="Enter age" />
                </div>
                <div class="col-md-6 offset-md-3 mt-3">                    
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-dark w-100">Update</button>  
                </div>
            </form>
        </div>
    </div>
</body>
</html>
